    "test:integration": "node --test tests/integration.test.ts",
    "simulate": "node apps/cli.ts",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.61.1",
    "typescript": "5.9.3"
  }
